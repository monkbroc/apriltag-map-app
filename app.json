{
  "expo": {
    "name": "AprilTag Map",
    "slug": "apriltag-map",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.monkbroc.apriltagmap",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used to scan AprilTags and track the phone position with ARKit while building field maps."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.monkbroc.apriltagmap",
      "permissions": ["android.permission.CAMERA"]
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-sharing"],
    "scheme": "apriltagmap",
    "experiments": {
      "typedRoutes": true
    },
    "owner": "jvaniers-team",
    "extra": {
      "eas": {
        "projectId": "874bc557-1d08-4f44-b1f3-d9aeeb23a4f3"
      }
    },
    "platforms": ["ios", "android"]
  }
}
